<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark-only launch theme. The real UI is Compose; this exists so the window
      background matches the dashboard before the first frame is drawn.
    -->
    <style name="Theme.Obd2Dashboard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
