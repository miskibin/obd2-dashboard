<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Modern Bluetooth permissions (Android 12 / API 31+). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Legacy Bluetooth permissions, only needed up to Android 11. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Required for BLE scanning up to Android 11 only. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Keeps the polling loop alive while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- The foreground service notification is the only one the app ever posts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The AI assistant apps a recorded trip can be sent to directly. Android 11+ hides
        other packages unless they are declared here, so this list must stay in step with
        AiAssistants.KNOWN_PACKAGES — a package missing here is silently never offered.
    -->
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.microsoft.copilot" />
        <package android:name="ai.perplexity.app.android" />
    </queries>

    <!--
        Not required: a classic-SPP dongle over RFCOMM is a first-class transport here, and
        a phone with Bluetooth but no LE can still use one.
    -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application
        android:name=".Obd2DashboardApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Obd2Dashboard"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.Obd2Dashboard"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ObdConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Android Auto: the templated car-screen app. Exported because the Auto host
             binds to it from outside; who may bind is enforced by the service's
             HostValidator rather than by a permission. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <service
            android:name=".car.DashboardCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!-- Grants the share sheet read access to a single exported trip CSV. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
